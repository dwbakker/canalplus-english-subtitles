{
  "manifest_version": 3,
  "name": "English Subtitles for CANAL+",
  "version": "0.7.3",
  "description": "Translates CANAL+ French subtitles into English, with Claude or Apple's on-device translator, in sync with the video.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png", "256": "icon-256.png", "512": "icon-512.png" },
  "permissions": ["storage", "unlimitedStorage", "nativeMessaging"],
  "host_permissions": [
    "*://*.canalplus.com/*",
    "*://*.akamaized.net/*",
    "*://*.canalplus-bo.net/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.canalplus.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "64": "icon-64.png" }, "default_title": "English Subtitles for CANAL+" }
}
